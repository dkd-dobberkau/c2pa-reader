{
    "name": "dkd/c2pa-reader",
    "type": "typo3-cms-extension",
    "description": "Reads and verifies C2PA Content Credentials on upload to the TYPO3 file list (FAL) and stores the result in sys_file_metadata.",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": "^8.3",
        "typo3/cms-core": "^14.0",
        "provemark/c2pa-verifier": "^0.11"
    },
    "autoload": {
        "psr-4": {
            "Dkd\\C2paReader\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "c2pa_reader",
            "web-dir": ".Build/public"
        }
    },
    "require-dev": {
        "typo3/testing-framework": "^9.7",
        "phpunit/phpunit": "^12.1"
    },
    "autoload-dev": {
        "psr-4": {
            "Dkd\\C2paReader\\Tests\\": "Tests/"
        }
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "scripts": {
        "test:unit": "phpunit -c Build/phpunit/UnitTests.xml",
        "test:functional": "phpunit -c Build/phpunit/FunctionalTests.xml",
        "test": [
            "@test:unit",
            "@test:functional"
        ]
    }
}
